[
  {"id": "gq-02a", "slot": "gq-02", "prompt": "사과 3개가 1,200원이다. 같은 사과 7개는 얼마인가? (단위: 원)", "choices": ["2,400", "2,800", "3,200", "3,600"], "answer": 1, "params": {"verify": "1200 / 3 * 7"}, "explanation": "1개에 400원이므로 7개는 400 × 7 = 2,800원입니다.", "expected_p": 0.85},
  {"id": "gq-02b", "slot": "gq-02", "prompt": "시속 60km로 2시간 30분 동안 달린 거리는? (단위: km)", "choices": ["120", "140", "150", "160"], "answer": 2, "params": {"verify": "60 * 2.5"}, "explanation": "2시간 30분은 2.5시간이므로 60 × 2.5 = 150km입니다.", "expected_p": 0.85},
  {"id": "gq-08a", "slot": "gq-08", "prompt": "A가 혼자 하면 6시간, B가 혼자 하면 3시간 걸리는 일이 있다. 둘이 함께 하면 몇 시간이 걸리는가? (단위: 시간)", "choices": ["1.5", "2", "2.5", "4.5"], "answer": 1, "params": {"verify": "1 / (1/6 + 1/3)"}, "explanation": "1시간에 A는 1/6, B는 1/3을 하므로 함께 1/2을 합니다. 따라서 2시간이 걸립니다.", "expected_p": 0.4},
  {"id": "gq-08b", "slot": "gq-08", "prompt": "5명이 한 줄로 설 때, A와 B가 바로 옆에 서는 경우의 수는?", "choices": ["24", "48", "60", "120"], "answer": 1, "params": {"verify": "math.factorial(4) * 2"}, "explanation": "A와 B를 한 묶음으로 보면 4개를 줄 세우는 4! = 24가지이고, 묶음 안에서 A·B 순서가 2가지이므로 48가지입니다.", "expected_p": 0.35},
  {"id": "gq-02c", "slot": "gq-02", "prompt": "공책 한 권이 800원이다. 5,000원으로 공책을 최대 몇 권 살 수 있는가? (단위: 권)", "choices": ["5", "6", "7", "8"], "answer": 1, "explanation": "800 × 6 = 4,800원이고, 7권은 5,600원이라 살 수 없습니다.", "expected_p": 0.85, "params": {"verify": "5000 // 800"}},
  {"id": "gq-02d", "slot": "gq-02", "prompt": "하루에 12쪽씩 읽으면 96쪽짜리 책을 며칠 만에 다 읽는가? (단위: 일)", "choices": ["6", "7", "8", "9"], "answer": 2, "explanation": "96 ÷ 12 = 8일입니다.", "expected_p": 0.9, "params": {"verify": "96 / 12"}},
  {"id": "gq-02e", "slot": "gq-02", "prompt": "한 반 학생 30명 중 40%가 안경을 썼다. 안경을 쓰지 않은 학생은 몇 명인가? (단위: 명)", "choices": ["12", "15", "18", "20"], "answer": 2, "explanation": "안경을 쓰지 않은 학생은 60%이므로 30 × 0.6 = 18명입니다. 12명은 안경 쓴 학생 수입니다.", "expected_p": 0.8, "params": {"verify": "30 * 0.6"}},
  {"id": "gq-02f", "slot": "gq-02", "prompt": "오전 9시 40분에 출발해 2시간 35분 뒤에 도착했다. 도착 시각은 낮 12시 몇 분인가? (단위: 분)", "choices": ["5", "15", "25", "75"], "answer": 1, "explanation": "9시 40분 + 2시간 = 11시 40분, 여기에 35분을 더하면 12시 15분입니다.", "expected_p": 0.8, "params": {"verify": "(9 * 60 + 40 + 155) - 12 * 60"}},
  {"id": "gq-08c", "slot": "gq-08", "prompt": "소금물 200g에 소금 20g이 녹아 있다. 물을 몇 g 더 넣어야 농도가 8%가 되는가? (단위: g)", "choices": ["40", "50", "60", "80"], "answer": 1, "explanation": "소금 20g이 8%가 되려면 전체가 20 ÷ 0.08 = 250g이어야 하므로 물 50g을 더 넣습니다.", "expected_p": 0.4, "params": {"verify": "20 / 0.08 - 200"}},
  {"id": "gq-08d", "slot": "gq-08", "prompt": "원가에 30% 이익을 붙여 정가를 정했다. 정가에서 1,500원을 할인해 팔았더니 원가의 20% 이익이 남았다. 원가는? (단위: 원)", "choices": ["12,000", "13,000", "15,000", "18,000"], "answer": 2, "explanation": "원가를 x라 하면 1.3x − 1,500 = 1.2x 이므로 0.1x = 1,500, x = 15,000원입니다.", "expected_p": 0.35, "params": {"verify": "1500 / 0.1"}},
  {"id": "gq-08e", "slot": "gq-08", "prompt": "A는 시속 4km, B는 시속 6km로 같은 지점에서 동시에 반대 방향으로 걸었다. 두 사람 사이가 25km가 되는 것은 몇 시간 뒤인가? (단위: 시간)", "choices": ["2", "2.5", "3", "5"], "answer": 1, "explanation": "반대 방향이므로 1시간에 4 + 6 = 10km씩 멀어집니다. 25 ÷ 10 = 2.5시간입니다.", "expected_p": 0.5, "params": {"verify": "25 / (4 + 6)"}},
  {"id": "gq-08f", "slot": "gq-08", "prompt": "어떤 수에 4를 곱해야 할 것을 잘못하여 4로 나누었더니 3이 되었다. 바르게 계산한 값은?", "choices": ["12", "36", "48", "64"], "answer": 2, "explanation": "어떤 수는 3 × 4 = 12이고, 바르게 계산하면 12 × 4 = 48입니다. 12는 어떤 수 자체입니다.", "expected_p": 0.45, "params": {"verify": "3 * 4 * 4"}}
]
