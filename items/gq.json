[
  {"id": "gq-applied-1a", "slot": "gq-applied-1", "prompt": "사과 3개가 1,200원이다. 같은 사과 7개는 얼마인가? (단위: 원)", "choices": ["2,400", "2,800", "3,200", "3,600"], "answer": 1, "params": {"verify": "1200 / 3 * 7"}, "explanation": "1개에 400원이므로 7개는 400 × 7 = 2,800원입니다.", "expected_p": 0.85},
  {"id": "gq-applied-1b", "slot": "gq-applied-1", "prompt": "시속 60km로 2시간 30분 동안 달린 거리는? (단위: km)", "choices": ["120", "140", "150", "160"], "answer": 2, "params": {"verify": "60 * 2.5"}, "explanation": "2시간 30분은 2.5시간이므로 60 × 2.5 = 150km입니다.", "expected_p": 0.85},
  {"id": "gq-applied-3a", "slot": "gq-applied-3", "prompt": "A가 혼자 하면 6시간, B가 혼자 하면 3시간 걸리는 일이 있다. 둘이 함께 하면 몇 시간이 걸리는가? (단위: 시간)", "choices": ["1.5", "2", "2.5", "4.5"], "answer": 1, "params": {"verify": "1 / (1/6 + 1/3)"}, "explanation": "1시간에 A는 1/6, B는 1/3을 하므로 함께 1/2을 합니다. 따라서 2시간이 걸립니다.", "expected_p": 0.4},
  {"id": "gq-applied-3b", "slot": "gq-applied-3", "prompt": "5명이 한 줄로 설 때, A와 B가 바로 옆에 서는 경우의 수는?", "choices": ["24", "48", "60", "120"], "answer": 1, "params": {"verify": "math.factorial(4) * 2"}, "explanation": "A와 B를 한 묶음으로 보면 4개를 줄 세우는 4! = 24가지이고, 묶음 안에서 A·B 순서가 2가지이므로 48가지입니다.", "expected_p": 0.35},
  {"id": "gq-applied-1c", "slot": "gq-applied-1", "prompt": "공책 한 권이 800원이다. 5,000원으로 공책을 최대 몇 권 살 수 있는가? (단위: 권)", "choices": ["5", "6", "7", "8"], "answer": 1, "explanation": "800 × 6 = 4,800원이고, 7권은 5,600원이라 살 수 없습니다.", "expected_p": 0.85, "params": {"verify": "5000 // 800"}},
  {"id": "gq-applied-1d", "slot": "gq-applied-1", "prompt": "하루에 12쪽씩 읽으면 96쪽짜리 책을 며칠 만에 다 읽는가? (단위: 일)", "choices": ["6", "7", "8", "9"], "answer": 2, "explanation": "96 ÷ 12 = 8일입니다.", "expected_p": 0.9, "params": {"verify": "96 / 12"}},
  {"id": "gq-applied-1e", "slot": "gq-applied-1", "prompt": "한 반 학생 30명 중 40%가 안경을 썼다. 안경을 쓰지 않은 학생은 몇 명인가? (단위: 명)", "choices": ["12", "15", "18", "20"], "answer": 2, "explanation": "안경을 쓰지 않은 학생은 60%이므로 30 × 0.6 = 18명입니다. 12명은 안경 쓴 학생 수입니다.", "expected_p": 0.8, "params": {"verify": "30 * 0.6"}},
  {"id": "gq-applied-1f", "slot": "gq-applied-1", "prompt": "오전 9시 40분에 출발해 2시간 35분 뒤에 도착했다. 도착 시각은 낮 12시 몇 분인가? (단위: 분)", "choices": ["5", "15", "25", "75"], "answer": 1, "explanation": "9시 40분 + 2시간 = 11시 40분, 여기에 35분을 더하면 12시 15분입니다.", "expected_p": 0.8, "params": {"verify": "(9 * 60 + 40 + 155) - 12 * 60"}},
  {"id": "gq-applied-3c", "slot": "gq-applied-3", "prompt": "소금물 200g에 소금 20g이 녹아 있다. 물을 몇 g 더 넣어야 농도가 8%가 되는가? (단위: g)", "choices": ["40", "50", "60", "80"], "answer": 1, "explanation": "소금 20g이 8%가 되려면 전체가 20 ÷ 0.08 = 250g이어야 하므로 물 50g을 더 넣습니다.", "expected_p": 0.4, "params": {"verify": "20 / 0.08 - 200"}},
  {"id": "gq-applied-3d", "slot": "gq-applied-3", "prompt": "원가에 30% 이익을 붙여 정가를 정했다. 정가에서 1,500원을 할인해 팔았더니 원가의 20% 이익이 남았다. 원가는? (단위: 원)", "choices": ["12,000", "13,000", "15,000", "18,000"], "answer": 2, "explanation": "원가를 x라 하면 1.3x − 1,500 = 1.2x 이므로 0.1x = 1,500, x = 15,000원입니다.", "expected_p": 0.35, "params": {"verify": "1500 / 0.1"}},
  {"id": "gq-applied-3e", "slot": "gq-applied-3", "prompt": "A는 시속 4km, B는 시속 6km로 같은 지점에서 동시에 반대 방향으로 걸었다. 두 사람 사이가 25km가 되는 것은 몇 시간 뒤인가? (단위: 시간)", "choices": ["2", "2.5", "3", "5"], "answer": 1, "explanation": "반대 방향이므로 1시간에 4 + 6 = 10km씩 멀어집니다. 25 ÷ 10 = 2.5시간입니다.", "expected_p": 0.5, "params": {"verify": "25 / (4 + 6)"}},
  {"id": "gq-applied-3f", "slot": "gq-applied-3", "prompt": "어떤 수에 4를 곱해야 할 것을 잘못하여 4로 나누었더니 3이 되었다. 바르게 계산한 값은?", "choices": ["12", "36", "48", "64"], "answer": 2, "explanation": "어떤 수는 3 × 4 = 12이고, 바르게 계산하면 12 × 4 = 48입니다. 12는 어떤 수 자체입니다.", "expected_p": 0.45, "params": {"verify": "3 * 4 * 4"}},
  {"id": "gq-applied-2a", "slot": "gq-applied-2", "prompt": "어떤 수를 5로 나누면 몫이 7이고 나머지가 3이다. 이 수는?", "choices": ["35", "38", "40", "43"], "answer": 1, "explanation": "5 × 7 + 3 = 38입니다.", "expected_p": 0.7, "params": {"verify": "5 * 7 + 3"}},
  {"id": "gq-applied-2b", "slot": "gq-applied-2", "prompt": "정가 8,000원인 물건을 20% 할인한 가격에서 500원 쿠폰을 더 썼다. 낸 돈은? (단위: 원)", "choices": ["5,900", "6,000", "6,400", "6,900"], "answer": 0, "explanation": "8,000 × 0.8 = 6,400원에서 500원을 빼면 5,900원입니다.", "expected_p": 0.65, "params": {"verify": "8000 * 0.8 - 500"}},
  {"id": "gq-applied-2c", "slot": "gq-applied-2", "prompt": "연필 3자루와 지우개 2개의 값은 1,900원이고, 연필 한 자루는 500원이다. 지우개 한 개의 값은? (단위: 원)", "choices": ["150", "200", "250", "300"], "answer": 1, "explanation": "지우개 2개는 1,900 − 1,500 = 400원이므로 1개는 200원입니다.", "expected_p": 0.65, "params": {"verify": "(1900 - 3 * 500) / 2"}},
  {"id": "gq-applied-2d", "slot": "gq-applied-2", "prompt": "어떤 일을 첫날 전체의 1/3만큼 하고, 그다음 날부터는 하루에 1/6씩 했다. 모두 며칠 만에 끝났는가? (단위: 일)", "choices": ["4", "5", "6", "7"], "answer": 1, "explanation": "남은 2/3를 하루 1/6씩 하면 4일이 걸리므로 첫날을 합쳐 5일입니다.", "expected_p": 0.55, "params": {"verify": "1 + (1 - 1/3) / (1/6)"}},
  {"id": "gq-applied-2e", "slot": "gq-applied-2", "prompt": "시계가 3시 30분을 가리킬 때 시침과 분침이 이루는 작은 각의 크기는? (단위: 도)", "choices": ["60", "75", "90", "105"], "answer": 1, "explanation": "분침은 180°, 시침은 3시에서 반 칸 더 간 105°에 있으므로 차이는 75°입니다.", "expected_p": 0.5, "params": {"verify": "abs(30 * 3.5 - 6 * 30)"}},
  {"id": "gq-applied-2f", "slot": "gq-applied-2", "prompt": "평균 80점인 학생 4명에 90점인 학생 1명이 더해졌다. 5명의 평균은? (단위: 점)", "choices": ["81", "82", "84", "85"], "answer": 1, "explanation": "총점 320 + 90 = 410점을 5로 나누면 82점입니다.", "expected_p": 0.65, "params": {"verify": "(80 * 4 + 90) / 5"}},
  {"id": "gq-applied-4a", "slot": "gq-applied-4", "prompt": "A와 B가 함께 하면 4일, A 혼자 하면 6일 걸리는 일이 있다. B 혼자 하면 며칠 걸리는가? (단위: 일)", "choices": ["8", "10", "12", "24"], "answer": 2, "explanation": "B가 하루에 하는 양은 1/4 − 1/6 = 1/12이므로 12일이 걸립니다.", "expected_p": 0.3, "params": {"verify": "1 / (1/4 - 1/6)"}},
  {"id": "gq-applied-4b", "slot": "gq-applied-4", "prompt": "농도 10% 소금물 300g과 농도 4% 소금물 200g을 섞으면 농도는 몇 %인가? (단위: %)", "choices": ["6.8", "7", "7.6", "8.2"], "answer": 2, "explanation": "소금은 30g + 8g = 38g, 전체 500g이므로 38 ÷ 500 = 7.6%입니다. 두 농도의 단순 평균 7%는 틀립니다.", "expected_p": 0.3, "params": {"verify": "(300 * 0.1 + 200 * 0.04) / 500 * 100"}},
  {"id": "gq-applied-4c", "slot": "gq-applied-4", "prompt": "열차가 길이 400m인 다리를 완전히 지나는 데 30초, 길이 1,000m인 터널을 완전히 지나는 데 60초가 걸렸다. 열차의 길이는? (단위: m)", "choices": ["100", "150", "200", "250"], "answer": 2, "explanation": "열차 길이를 L이라 하면 속력이 같으므로 (L + 400) ÷ 30 = (L + 1,000) ÷ 60, 2L + 800 = L + 1,000, L = 200m입니다.", "expected_p": 0.25, "params": {"verify": "(1000 - 2 * 400) / (2 - 1)"}},
  {"id": "gq-applied-4d", "slot": "gq-applied-4", "prompt": "물건값을 20% 올렸다가 다시 20% 내렸더니 처음보다 800원 싸졌다. 처음 가격은? (단위: 원)", "choices": ["16,000", "20,000", "24,000", "40,000"], "answer": 1, "explanation": "1.2 × 0.8 = 0.96이므로 처음 가격의 4%가 800원입니다. 800 ÷ 0.04 = 20,000원입니다.", "expected_p": 0.3, "params": {"verify": "800 / 0.04"}},
  {"id": "gq-applied-4e", "slot": "gq-applied-4", "prompt": "1부터 100까지의 자연수 중 3의 배수도 5의 배수도 아닌 수는 몇 개인가?", "choices": ["47", "53", "55", "60"], "answer": 1, "explanation": "3의 배수 33개 + 5의 배수 20개 − 15의 배수 6개 = 47개를 100에서 빼면 53개입니다.", "expected_p": 0.3, "params": {"verify": "100 - (33 + 20 - 6)"}},
  {"id": "gq-applied-4f", "slot": "gq-applied-4", "prompt": "주사위 2개를 동시에 던질 때 두 눈의 합이 8 이상이 되는 경우는 몇 가지인가?", "choices": ["10", "12", "15", "21"], "answer": 2, "explanation": "합이 8, 9, 10, 11, 12인 경우가 각각 5, 4, 3, 2, 1가지로 모두 15가지입니다.", "expected_p": 0.3, "params": {"verify": "sum(1 for a in range(1, 7) for b in range(1, 7) if a + b >= 8)"}}
]
